# ~/.config/git/config — репозиторий configs (общие настройки).
# Имя и почта — в identity рядом (файл создаёт ansible из записи пользователя в inventory).
# Если остался старый ~/.gitconfig — он читается после и перекрывает одноимённые
# ключи; удалить его вручную.
[include]
	path = identity
[init]
	defaultBranch = main
[credential]
	helper = cache --timeout=300
[core]
	editor = nvim
	autocrlf = input
	pager = delta
	# Только Git for Windows: пути длиннее 260 символов (MAX_PATH). На Linux игнорируется.
	longpaths = true
[pull]
	rebase = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
