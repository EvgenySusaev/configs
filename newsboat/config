# ~/.config/newsboat/config (roles/dev_dotfiles). Ленты — в соседнем файле urls.
auto-reload yes
reload-time 30
reload-threads 4
max-items 500
cleanup-on-quit yes
show-read-feeds no
prepopulate-query-feeds yes
confirm-exit yes

# навигация как в vim
bind-key j down
bind-key k up
bind-key h quit
bind-key l open
bind-key g home
bind-key G end
bind-key ^F pagedown
bind-key ^B pageup

# открывать ссылки в браузере по умолчанию
browser "xdg-open %u"

# Цвета лежат в colors рядом и не применяются. Включить — раскомментировать:
# include ~/.config/newsboat/colors
